# Copie ce fichier en .env.deploy (ignoré par git) et remplis-le. Utilisé par `npm run deploy`.
FTP_HOST=ftp.monsite.com
FTP_PORT=21
FTP_USER=mon_user
FTP_PASSWORD=mon_mot_de_passe
# false = FTP simple, true = FTPS explicite (FileZilla : "FTP sur TLS explicite"), implicit = FTPS implicite
FTP_SECURE=false
# true si le serveur FTPS a un certificat auto-signé
FTP_ALLOW_SELF_SIGNED=false
# Dossier distant du jeu ; chaque version est envoyée dans REMOTE_DIR/<version>/
REMOTE_DIR=/www/jeux/xiao-swarm
# Optionnel : affiché à la fin du déploiement (URL publique du dossier ci-dessus)
PUBLIC_URL=https://monsite.com/jeux/xiao-swarm
